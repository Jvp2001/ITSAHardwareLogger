<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
<!--            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %class{0}.%M[%line] -%kvp [%m]- %msg%n</pattern>-->
            <pattern>%d{HH:mm:ss.SSS} %-5level %class{0}.%M[%line] %msg%n</pattern>
        </encoder>
    </appender>
    <root level="info">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
